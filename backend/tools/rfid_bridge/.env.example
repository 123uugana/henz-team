RFID_WORKER_URL=https://hents-hurga-api.uuganbayrxx0716.workers.dev/api/rfid/scan
RFID_DEVICE_KEY=replace-with-wrangler-secret-value
RFID_READER_ID=hh100-raw-01

# server: PC runs a TCP server and the reader connects to the PC.
# client: PC connects to a reader at RFID_READER_CONN.
RFID_CONNECT_MODE=server

# Used in server mode. Set RFID_SERVER_HOST to your PC LAN IP if the SDK
# cannot listen on 0.0.0.0.
RFID_SERVER_HOST=0.0.0.0
RFID_SERVER_PORT=9090

# Used in client mode.
RFID_READER_CONN=TCP:192.168.1.116:9090

RFID_ANTENNAS=1
RFID_INVENTORY_SECONDS=0
RFID_INVENTORY_RETRY_SECONDS=5
RFID_SEND_INVENTORY_COMMAND=true
RFID_POST_TIMEOUT_SECONDS=10
