# Backend API base URL (no trailing slash)
BACKEND_URL=http://127.0.0.1:8787

# How often (seconds) to flush buffered tag reads to the backend
UPLOAD_INTERVAL_SECONDS=1.5

# --- Reader 1: HL7202K8 (Bluetooth UHF handheld, Indy R2000) ---
# https://www.hopelandrfid.com/product/Handheld-and-PDA-Bluetooth-UHF-Handheld-Reader.html
# Pair it in Windows Bluetooth settings first, then find the COM port it was
# assigned to (Device Manager -> Ports (COM & LPT) -> "Standard Serial over
# Bluetooth link (COMx)").
READER_HL7202K8_ENABLED=true
READER_HL7202K8_ID=hl7202k8-01
READER_HL7202K8_SECRET=change-me-hl7202k8-secret
READER_HL7202K8_CONNECTION=Serial:COM5:115200

# --- Reader 2: Wing HY820 (Android handheld/PDA, Impinj E710) ---
# https://www.hopelandrfid.com/product/handheld-and-PDA-rfid-reader-wing-HY820.html
# The HY820 is a full Android PDA. If its onboard reader app can be put into
# "TCP server" mode on the same Wi-Fi network as this PC, connect to it here.
# If it can only push scans over HTTP, skip this bridge for it and point its
# HTTP push feature straight at POST {BACKEND_URL}/api/devices/scans instead.
READER_HY820_ENABLED=true
READER_HY820_ID=hy820-01
READER_HY820_SECRET=change-me-hy820-secret
READER_HY820_CONNECTION=TCP:192.168.1.116:9090
