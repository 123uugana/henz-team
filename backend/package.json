{
  "name": "hents-hurga-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev --config wrangler.toml",
    "worker:deploy": "wrangler deploy --config wrangler.toml",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:migrate": "wrangler d1 migrations apply hents-hurag --remote --config wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply hents-hurag --local --config wrangler.toml",
    "db:seed:local": "wrangler d1 execute hents-hurag --local --file=seed/demo.sql --config wrangler.toml",
    "db:seed:remote": "wrangler d1 execute hents-hurag --remote --file=seed/demo.sql --config wrangler.toml",
    "test": "node ../scripts/run-vitest-from-copy.mjs run",
    "test:watch": "node ../scripts/run-vitest-from-copy.mjs",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^26.3.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
